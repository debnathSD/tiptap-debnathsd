{
  "name": "tiptap-pages-video",
  "private": true,
  "version": "0.1.0",
  "description": "Remotion product demo for Tiptap Pages (React Three Fiber + cannon-es physics + real app screenshots).",
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "soundtrack": "node scripts/soundtrack.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ProductDemo ../public/tour/tiptap-pages-demo.mp4",
    "poster": "remotion still src/index.ts ProductDemo ../public/tour/poster.jpg --frame=100",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.538",
    "@remotion/three": "4.0.538",
    "cannon-es": "0.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.1",
    "playwright": "1.64.1",
    "typescript": "~5.9.3"
  }
}
